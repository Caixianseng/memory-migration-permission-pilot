  "qualification_questions": {
    "schema_version": "1.0",
    "stories": [
      {
        "questions": [
          {
            "question_id": "Q1",
            "text": "汐桥社区本批纸本阅读礼包接收单位的签收联系人是谁？"
          },
          {
            "question_id": "Q2",
            "text": "本批纸本阅读礼包封箱前，每包必须核对哪两类交付物品？"
          },
          {
            "question_id": "Q3",
            "text": "汐桥社区本批纸本阅读礼包寄送费用的含税支出上限是多少元？"
          }
        ],
        "story_id": "qual_reading_parcels"
      }
    ]
  },
  "qualification_sources": {
    "schema_version": "1.0",
    "stories": [
      {
        "sources": [
          {
            "source_id": "S01",
            "text": "汐桥社区本批纸本阅读礼包的寄送费用已经核定，含税支出上限为9,130元。该额度覆盖纸本印制、纸箱包材和邮寄三项支出，按实际寄出的礼包数量结算，不含志愿者个人交通费用。经办人应逐笔保存票据，由社区文教专员汇总后提交核销；超出额度的追加寄送须单独提出申请，不能沿用本批额度直接报销。未寄出的备用包材仍归社区库存管理，不作为已发生邮寄费用登记。"
          },
          {
            "source_id": "S02",
            "text": "汐桥社区本批纸本阅读礼包的接收清单已完成核对。接收单位的签收联系人是戚晴，包裹面单的联系人栏和交接回执均使用这个姓名，不能改填负责录入清单的志愿者。寄出前由两名工作人员核对接收单位名称及邮编，出现地址缺字时先回查书面登记，不凭口头印象补写。寄出的面单存根按袋号整理，与交接回执装在同一个档案袋内，便于之后核对每袋实际到件情况。"
          },
          {
            "source_id": "S03",
            "text": "纸本阅读礼包采用逐包核对、逐包封箱的装配方式。封箱前每包必须核对书册和阅读记录卡这两类物品，确认齐全后再贴袋号；装箱纸条只是内部操作提示，不属于需要交付的礼包内容。发现书册页角受潮时，应把该册放到待检查区后换入完好书册，不得把问题册继续封进礼包。阅读记录卡统一放在书册前侧，包好后轻晃纸箱检查松动情况，确认没有遗漏再交给贴面单岗位。"
          },
          {
            "source_id": "S04",
            "text": "装配台使用的封箱胶带统一放在右侧抽屉，拆封后的胶带卷先用完再领取新卷。空纸箱应平整叠放，外包装的运输箭头保持朝上，台面边缘不堆放剪刀。当天装配结束后把胶带头折出一个小角，便于下一班开工时找到起点；卷芯用尽后放入纸类回收篓。值日人员只登记胶带领用卷数，不把胶带剩余长度换算成礼包数量，也不在胶带外侧书写接收单位名称。"
          }
        ],
        "story_id": "qual_reading_parcels"
      }
    ]
  }
