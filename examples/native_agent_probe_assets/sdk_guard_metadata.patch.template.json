        "id": "study-single-request-guard",
        "name": "__GUARD_FILE_URI__",
        "config": {
          "receiptPath": "__GUARD_RECEIPT_PATH__",
          "maxRequests": 1,
          "maxTokens": 64,
          "maxRequestBytes": 65536,
          "provider": "deepseek-account",
          "model": "deepseek-flash"
